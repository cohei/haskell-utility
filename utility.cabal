cabal-version: 3.8
name: utility
version: 0.1.0.0
homepage: https://github.com/cohei/haskell-utility#readme
bug-reports: https://github.com/cohei/haskell-utility/issues
author: TANIGUCHI Kohei
maintainer: a.d.xvii.kal.mai@gmail.com
copyright: 2018 TANIGUCHI Kohei
license: BSD-3-Clause
license-file: LICENSE

source-repository head
  type: git
  location: https://github.com/cohei/haskell-utility

common warning
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wmissing-import-lists
    -Wmissing-local-signatures
    -Wmonomorphism-restriction
    -Wpartial-fields
    -Wredundant-constraints
    -fdefer-typed-holes

library
  import: warning
  hs-source-dirs: src
  exposed-modules: Utility
  ghc-options: -O0
  build-depends:
    base >=4.7 && <5

test-suite doctest
  import: warning
  hs-source-dirs: test
  main-is: doctests.hs
  build-depends:
    base >=4.7 && <5,
    doctest,
